# Copy the needed values into scripts/settings.local.env or export them.

PY=/path/to/python
CUDA_VISIBLE_DEVICES=0,1,2,3

# Set the model for the selected task. Both workflows use the text backbone and
# the bash/Python ReAct protocol.
MATH_MODEL_PATH=/path/to/Qwen3.5-4B-text
DOCVQA_MODEL_PATH=/path/to/Qwen3.5-4B-text

# One named ES run feeds the other three actions.
TRAIN_RUN_ID=my_es_run
ES_HISTORY=/path/to/history.json

# Optional overrides.
ES_GENERATIONS=25
ES_POPULATION=16
ES_CASE_BATCH_SIZE=16
EVAL_SAMPLES=4
MAX_MODEL_LEN=131072
MAX_TURNS=50

# Trace2Skill uses OPENAI_API_KEY and an official/local Trace2Skill checkout.
TRACE2SKILL_ROOT=/path/to/trace2skill/source
TRACE2SKILL_ANALYSIS_MODEL=gpt-5.4-nano
TRACE2SKILL_EVOLUTION_MODEL=gpt-5.4-nano
