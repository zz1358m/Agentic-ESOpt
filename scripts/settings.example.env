# Copy to scripts/settings.local.env and edit for one machine.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${PY:-python}"

# Local model server settings.
MODEL="${MODEL:-}"
GPUS="${GPUS:-0 1 2 3}"
PORTS="${PORTS:-11013 11014 11015 11016}"
HOST="${HOST:-127.0.0.1}"
MODEL_SERVER_EXTRA_ARGS="${MODEL_SERVER_EXTRA_ARGS:-}"

# Shared local completion endpoints.
LLM_LOCAL_URL="${LLM_LOCAL_URL:-http://127.0.0.1:11013/completions}"
ES_ENGINE_URLS="${ES_ENGINE_URLS:-http://127.0.0.1:11013/completions,http://127.0.0.1:11014/completions,http://127.0.0.1:11015/completions,http://127.0.0.1:11016/completions}"

# Common ES defaults.
ES_SIGMA_START="${ES_SIGMA_START:-1e-3}"
ES_SIGMA_END="${ES_SIGMA_END:-1e-3}"
ES_SIGMA_SCHEDULE="${ES_SIGMA_SCHEDULE:-constant}"
ES_SIGMA_WARMUP_STEPS="${ES_SIGMA_WARMUP_STEPS:-0}"
ES_ALPHA="${ES_ALPHA:-5e-4}"
ES_SEED="${ES_SEED:-2024}"
ES_OPERATORS="${ES_OPERATORS:-e1,e2,m1,m2}"

# WebArena service host.
WEBARENA_HOST="${WEBARENA_HOST:-127.0.0.1}"

# WebArena-Lite maintained defaults.
WEBARENA_MODEL_NAME="${WEBARENA_MODEL_NAME:-Qwen3.5-27B}"
WEBARENA_ES_ENDPOINTS="${WEBARENA_ES_ENDPOINTS:-http://127.0.0.1:11013,http://127.0.0.1:11014,http://127.0.0.1:11015,http://127.0.0.1:11016}"
WEBARENA_ES_POPULATION="${WEBARENA_ES_POPULATION:-8}"
WEBARENA_ES_CASE_BATCH="${WEBARENA_ES_CASE_BATCH:-8}"
WEBARENA_ES_GENERATIONS="${WEBARENA_ES_GENERATIONS:-1}"
WEBARENA_ES_SIGMA_START="${WEBARENA_ES_SIGMA_START:-5e-4}"
WEBARENA_ES_SIGMA_END="${WEBARENA_ES_SIGMA_END:-5e-4}"
WEBARENA_ES_SIGMA_SCHEDULE="${WEBARENA_ES_SIGMA_SCHEDULE:-constant}"
WEBARENA_ES_SIGMA_WARMUP_STEPS="${WEBARENA_ES_SIGMA_WARMUP_STEPS:-0}"
WEBARENA_ES_ALPHA="${WEBARENA_ES_ALPHA:-5e-4}"
WEBARENA_ES_SCOPE="${WEBARENA_ES_SCOPE:-full}"
WEBARENA_TRAIN_SPLIT="${WEBARENA_TRAIN_SPLIT:-$ROOT/data/webarena/vab_nonlite_split/train/items.json}"
WEBARENA_EVAL_SPLIT="${WEBARENA_EVAL_SPLIT:-$ROOT/data/webarena/vab_lite_split/items.json}"
WEBARENA_TRAIN_CONFIG_DIR="${WEBARENA_TRAIN_CONFIG_DIR:-$ROOT/data/webarena/vab-lite/config_files/wa/test_webarena}"
WEBARENA_CONFIG_DIR="${WEBARENA_CONFIG_DIR:-$ROOT/data/webarena/vab-lite/config_files/wa/test_webarena_lite}"
TRACE2SKILL_MAX_SKILL_LINES="${TRACE2SKILL_MAX_SKILL_LINES:-20}"

# Extra Trace2Skill settings.
TRACE2SKILL_ROOT="${TRACE2SKILL_ROOT:-$ROOT/webarena-train-time/methods/trace2skill/source}"
TRACE2SKILL_OPTIMIZER_MODEL="${TRACE2SKILL_OPTIMIZER_MODEL:-gpt-4.1-mini}"
TRACE2SKILL_WORKERS="${TRACE2SKILL_WORKERS:-8}"
TRACE2SKILL_RUN_ID="${TRACE2SKILL_RUN_ID:-webarena_trace2skill}"
TRACE2SKILL_SPLIT_DIR="${TRACE2SKILL_SPLIT_DIR:-$ROOT/data/webarena/vab_nonlite_split}"
TRACE2SKILL_STEPS="${TRACE2SKILL_STEPS:-1}"
TRACE2SKILL_MODEL_ENDPOINTS="${TRACE2SKILL_MODEL_ENDPOINTS:-http://127.0.0.1:12013/completions http://127.0.0.1:12014/completions http://127.0.0.1:12015/completions http://127.0.0.1:12016/completions}"

# Math Reasoning ES defaults.
MATH_ES_ENDPOINTS="${MATH_ES_ENDPOINTS:-$WEBARENA_ES_ENDPOINTS}"
MATH_ES_POPULATION="${MATH_ES_POPULATION:-8}"
MATH_ES_CASE_BATCH="${MATH_ES_CASE_BATCH:-8}"
MATH_ES_GENERATIONS="${MATH_ES_GENERATIONS:-1}"
MATH_ES_SIGMA_START="${MATH_ES_SIGMA_START:-5e-4}"
MATH_ES_SIGMA_END="${MATH_ES_SIGMA_END:-5e-4}"
MATH_ES_SIGMA_SCHEDULE="${MATH_ES_SIGMA_SCHEDULE:-constant}"
MATH_ES_SIGMA_WARMUP_STEPS="${MATH_ES_SIGMA_WARMUP_STEPS:-0}"
MATH_ES_ALPHA="${MATH_ES_ALPHA:-5e-4}"
MATH_ES_SCOPE="${MATH_ES_SCOPE:-full}"
MATH_MODEL_NAME="${MATH_MODEL_NAME:-Qwen3.5-27B}"

# DocVQA ES defaults.
DOCVQA_ES_ENDPOINTS="${DOCVQA_ES_ENDPOINTS:-http://127.0.0.1:11013}"
DOCVQA_ENDPOINT_MODE="${DOCVQA_ENDPOINT_MODE:-openai_vision_chat}"
DOCVQA_ES_POPULATION="${DOCVQA_ES_POPULATION:-8}"
DOCVQA_ES_CASE_BATCH="${DOCVQA_ES_CASE_BATCH:-8}"
DOCVQA_ES_GENERATIONS="${DOCVQA_ES_GENERATIONS:-1}"
DOCVQA_ES_SIGMA_START="${DOCVQA_ES_SIGMA_START:-5e-4}"
DOCVQA_ES_SIGMA_END="${DOCVQA_ES_SIGMA_END:-5e-4}"
DOCVQA_ES_SIGMA_SCHEDULE="${DOCVQA_ES_SIGMA_SCHEDULE:-constant}"
DOCVQA_ES_SIGMA_WARMUP_STEPS="${DOCVQA_ES_SIGMA_WARMUP_STEPS:-0}"
DOCVQA_ES_ALPHA="${DOCVQA_ES_ALPHA:-5e-4}"
DOCVQA_ES_SCOPE="${DOCVQA_ES_SCOPE:-full}"
DOCVQA_MODEL_NAME="${DOCVQA_MODEL_NAME:-local-vision-model}"
DOCVQA_MODEL_PATH="${DOCVQA_MODEL_PATH:-}"
DOCVQA_SERVER_GPU="${DOCVQA_SERVER_GPU:-0}"
DOCVQA_SERVER_HOST="${DOCVQA_SERVER_HOST:-127.0.0.1}"
DOCVQA_SERVER_PORT="${DOCVQA_SERVER_PORT:-11013}"
DOCVQA_SERVER_EXTRA_ARGS="${DOCVQA_SERVER_EXTRA_ARGS:-}"

# Sudoku defaults.
SUDOKU_MODEL_NAME="${SUDOKU_MODEL_NAME:-Llama-3.1-8B-Instruct}"
SUDOKU_ES_ENDPOINTS="${SUDOKU_ES_ENDPOINTS:-$WEBARENA_ES_ENDPOINTS}"
SUDOKU_TRAIN_SIZE="${SUDOKU_TRAIN_SIZE:-128}"
SUDOKU_EVAL_SIZE="${SUDOKU_EVAL_SIZE:-128}"
SUDOKU_MASK_COUNTS="${SUDOKU_MASK_COUNTS:-5,10,15,20}"
SUDOKU_TARGET_MASK_COUNT="${SUDOKU_TARGET_MASK_COUNT:-15}"
SUDOKU_MAX_TURNS="${SUDOKU_MAX_TURNS:-90}"
SUDOKU_ES_POPULATION="${SUDOKU_ES_POPULATION:-8}"
SUDOKU_ES_CASE_BATCH="${SUDOKU_ES_CASE_BATCH:-8}"
SUDOKU_ES_GENERATIONS="${SUDOKU_ES_GENERATIONS:-1}"
SUDOKU_ES_SIGMA_START="${SUDOKU_ES_SIGMA_START:-5e-4}"
SUDOKU_ES_SIGMA_END="${SUDOKU_ES_SIGMA_END:-5e-4}"
SUDOKU_ES_SIGMA_SCHEDULE="${SUDOKU_ES_SIGMA_SCHEDULE:-constant}"
SUDOKU_ES_SIGMA_WARMUP_STEPS="${SUDOKU_ES_SIGMA_WARMUP_STEPS:-0}"
SUDOKU_ES_ALPHA="${SUDOKU_ES_ALPHA:-5e-4}"
SUDOKU_ES_SCOPE="${SUDOKU_ES_SCOPE:-full}"
SUDOKU_GRPO_MODEL="${SUDOKU_GRPO_MODEL:-}"
# Math/DocVQA GRPO defaults to bundled ./algorithms/verl; set this only to override it.
VERL_ROOT="${VERL_ROOT:-}"
