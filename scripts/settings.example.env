# Copy to scripts/settings.local.env and edit for one machine.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="${PY:-python}"

# Local model server settings.
MODEL="${MODEL:-}"
GPUS="${GPUS:-0 1 2 3}"
PORTS="${PORTS:-11013 11014 11015 11016}"
HOST="${HOST:-127.0.0.1}"

# Shared local completion endpoints.
LLM_LOCAL_URL="${LLM_LOCAL_URL:-http://127.0.0.1:11013/completions}"
ES_ENGINE_URLS="${ES_ENGINE_URLS:-http://127.0.0.1:11013/completions,http://127.0.0.1:11014/completions,http://127.0.0.1:11015/completions,http://127.0.0.1:11016/completions}"

# Common ES defaults.
ES_SIGMA="${ES_SIGMA:-1e-3}"
ES_ALPHA="${ES_ALPHA:-5e-4}"
ES_OPERATORS="${ES_OPERATORS:-e1,e2,m1,m2}"

# WebArena service host.
WEBARENA_HOST="${WEBARENA_HOST:-127.0.0.1}"

# WebArena-Lite paper defaults.
WEBARENA_MODEL_NAME="${WEBARENA_MODEL_NAME:-Qwen3.5-27B}"
WEBARENA_ES_ENDPOINTS="${WEBARENA_ES_ENDPOINTS:-http://127.0.0.1:11013,http://127.0.0.1:11014,http://127.0.0.1:11015,http://127.0.0.1:11016}"
WEBARENA_ES_POPULATION="${WEBARENA_ES_POPULATION:-8}"
WEBARENA_ES_CASE_BATCH="${WEBARENA_ES_CASE_BATCH:-8}"
WEBARENA_ES_GENERATIONS="${WEBARENA_ES_GENERATIONS:-1}"
WEBARENA_ES_SIGMA="${WEBARENA_ES_SIGMA:-5e-4}"
WEBARENA_ES_ALPHA="${WEBARENA_ES_ALPHA:-5e-4}"
WEBARENA_ES_SCOPE="${WEBARENA_ES_SCOPE:-full}"
TRACE2SKILL_MAX_SKILL_LINES="${TRACE2SKILL_MAX_SKILL_LINES:-20}"
TRACE2SKILL_SKILL_FILE="${TRACE2SKILL_SKILL_FILE:-$ROOT/webarena-train-time/skills/dynamic_agent_trace2skill_generation.md}"
